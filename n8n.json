        -32
      ],
      "id": "c1994f28-ad75-462b-972e-0027b128a26d",
      "name": "analizando del documento",
      "credentials": {
        "googlePalmApi": {
          "id": "OKPAxwR5gHxZ5pYa",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const texto = $input.first().json.content.parts[0].text;\n\nconst datos = JSON.parse(texto);\n\nconst vacante = $('Webhook').first().json.body.vacante;\n\nconst experiencia = $('Webhook').first().json.body.experiencia;\n\nconst formaciones = datos.formaciones || [];\n\nconst niveles = [\n  { palabras: ['doctorado'], prioridad: 6 },\n  { palabras: ['maestría', 'maestria', 'master'], prioridad: 5 },\n  { palabras: ['universitario', 'universidad', 'pregrado', 'licenciatura'], prioridad: 4 },\n  { palabras: ['tecnología', 'tecnologia', 'tecnólogo', 'tecnologo'], prioridad: 3 },\n  { palabras: ['técnico', 'tecnico'], prioridad: 2 },\n  { palabras: ['bachillerato', 'bachiller'], prioridad: 1 }\n];\n\nlet nivelEducativo = 'No especificado';\nlet prioridadMayor = 0;\n\nfor (const formacion of formaciones) {\n\n  const textoFormacion = String(\n    formacion.titulo || ''\n  ).toLowerCase();\n\n  for (const nivel of niveles) {\n\n    const encontrado = nivel.palabras.some(palabra =>\n      textoFormacion.includes(palabra)\n    );\n\n    if (\n      encontrado &&\n      nivel.prioridad > prioridadMayor\n    ) {\n      nivelEducativo = formacion.titulo;\n      prioridadMayor = nivel.prioridad;\n    }\n  }\n}\n\nconst idCandidato =\n  'TF-' +\n  $now.toFormat('yyyyMMddHHmmss') +\n  '-' +\n  Math.floor(Math.random() * 10000);\n\n\nreturn [\n  {\n    json: {\n      ID_candidato:idCandidato,\n      ...datos,\n      nivel_Educativo:nivelEducativo,\n      vacante: vacante,\n      experiencia: experiencia\n    }\n  }\n];"
      },
