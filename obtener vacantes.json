      "name": "tomar desicion de clasificacion"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\n// Datos del candidato\nconst habilidades = item.habilidades || [];\nconst experiencia = Number(item.experiencia || 0);\n\n// Requisitos de la vacante\nconst requisitos = item.req_habilidades || [];\nconst expMinima = Number(item.exp_minima || 0);\n\n// Normalizamos los textos para comparar sin importar mayúsculas/minúsculas\nconst habilidadesNormalizadas = habilidades.map(h =>\n  String(h).trim().toLowerCase()\n);\n\nconst requisitosNormalizados = requisitos.map(h =>\n  String(h).trim().toLowerCase()\n);\n\n// Buscamos coincidencias\nconst habilidadesCoincidentes = requisitosNormalizados.filter(req =>\n  habilidadesNormalizadas.includes(req)\n);\n\n// Calculamos porcentaje de habilidades\nlet porcentajeHabilidades = 0;\n\nif (requisitosNormalizados.length > 0) {\n  porcentajeHabilidades =\n    habilidadesCoincidentes.length / requisitosNormalizados.length;\n}\n\n// Habilidades = 70 puntos\nconst puntosHabilidades = porcentajeHabilidades * 70;\n\n// Experiencia = 30 puntos\nconst puntosExperiencia = experiencia >= expMinima ? 30 : 0;\n\n// Score final\nconst score = Math.round(puntosHabilidades + puntosExperiencia);\n\n// Clasificación\nlet clasificacion;\n\nif (score >= 80) {\n  clasificacion = \"Alta\";\n} else if (score >= 60) {\n  clasificacion = \"Media\";\n} else {\n  clasificacion = \"Baja\";\n}\n\nreturn [\n  {\n    json: {\n      ...item,\n\n      habilidades_coincidentes: habilidadesCoincidentes,\n      total_requisitos: requisitosNormalizados.length,\n      requisitos_cumplidos: habilidadesCoincidentes.length,\n\n      puntos_habilidades: Math.round(puntosHabilidades),\n      puntos_experiencia: puntosExperiencia,\n\n      score: score,\n      clasificacion: clasificacion\n    }\n  }\n];"
      },
