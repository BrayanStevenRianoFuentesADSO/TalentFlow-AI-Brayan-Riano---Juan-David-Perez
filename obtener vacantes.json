    {
      "parameters": {
        "sendTo": "={{ $json.Correo }}",
        "subject": "Postulacion Aprobada",
        "message": "=<div style=\"margin:0; padding:0; background-color:#f4f7fb; font-family:Arial, Helvetica, sans-serif; color:#1f2937;\">\n\n  <!-- Contenedor principal -->\n  <div style=\"max-width:650px; margin:0 auto; padding:40px 20px;\">\n\n    <!-- Header -->\n    <div style=\"background-color:#172554; border-radius:14px 14px 0 0; padding:28px 35px; text-align:center;\">\n\n      <div style=\"font-size:28px; font-weight:bold; color:#ffffff; letter-spacing:0.5px;\">\n        Talent<span style=\"color:#38bdf8;\">Flow</span>\n      </div>\n\n      <div style=\"margin-top:8px; font-size:13px; color:#bfdbfe; letter-spacing:1px;\">\n        GESTIÓN DE TALENTO\n      </div>\n\n    </div>\n\n    <!-- Contenido -->\n    <div style=\"background-color:#ffffff; padding:40px 35px; border-radius:0 0 14px 14px; box-shadow:0 5px 20px rgba(15, 23, 42, 0.08);\">\n\n      <!-- Saludo -->\n      <p style=\"font-size:16px; margin:0 0 20px 0; color:#374151;\">\n        Hola <strong style=\"color:#172554;\">{{ $json.Nombre }}</strong>,\n      </p>\n\n      <h1 style=\"font-size:24px; color:#172554; margin:0 0 18px 0;\">\n        ¡Tu postulación ha sido registrada!\n      </h1>\n\n      <p style=\"font-size:15px; line-height:1.7; color:#4b5563; margin:0 0 25px 0;\">\n        Te informamos que hemos recibido correctamente tu postulación.\n        A continuación encontrarás los detalles asociados a tu proceso:\n      </p>\n\n      <!-- Tarjeta de información -->\n      <div style=\"border:1px solid #e5e7eb; border-radius:10px; overflow:hidden; margin-bottom:28px;\">\n\n        <!-- Título -->\n        <div style=\"background-color:#f8fafc; padding:16px 20px; border-bottom:1px solid #e5e7eb;\">\n          <span style=\"font-size:14px; font-weight:bold; color:#172554;\">\n            DETALLES DE LA POSTULACIÓN\n          </span>\n        </div>\n\n        <!-- Vacante -->\n        <div style=\"padding:18px 20px; border-bottom:1px solid #f1f5f9;\">\n\n          <div style=\"font-size:12px; color:#6b7280; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:6px;\">\n            Vacante\n          </div>\n\n          <div style=\"font-size:17px; font-weight:bold; color:#172554;\">\n            {{ $json.Vacante }}\n          </div>\n\n        </div>\n\n        <!-- Fecha -->\n        <div style=\"padding:18px 20px; border-bottom:1px solid #f1f5f9;\">\n\n          <div style=\"font-size:12px; color:#6b7280; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:6px;\">\n            Fecha de postulación\n          </div>\n\n          <div style=\"font-size:15px; color:#374151;\">\n            {{ $json.Fecha_Postulacion }}\n          </div>\n\n        </div>\n\n        <!-- Estado -->\n        <div style=\"padding:18px 20px;\">\n\n          <div style=\"font-size:12px; color:#6b7280; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:8px;\">\n            Estado actual\n          </div>\n\n          <span style=\"display:inline-block; background-color:#e0f2fe; color:#0369a1; padding:7px 14px; border-radius:20px; font-size:13px; font-weight:bold;\">\n            {{ $json.Estado }}\n          </span>\n\n        </div>\n\n      </div>\n\n      <!-- Mensaje -->\n      <div style=\"background-color:#f8fafc; border-left:4px solid #38bdf8; padding:18px 20px; margin-bottom:28px; border-radius:0 6px 6px 0;\">\n\n        <p style=\"font-size:14px; line-height:1.7; color:#4b5563; margin:0;\">\n          Tu información ha sido registrada en nuestro sistema y será\n          evaluada de acuerdo con los criterios establecidos para la\n          vacante seleccionada.\n        </p>\n\n      </div>\n\n      <p style=\"font-size:15px; line-height:1.7; color:#4b5563; margin:0 0 10px 0;\">\n        Te recomendamos estar atento a tu correo electrónico para recibir\n        cualquier actualización relacionada con tu proceso de selección.\n      </p>\n\n      <p style=\"font-size:15px; color:#374151; margin:25px 0 0 0;\">\n        Gracias por confiar en <strong style=\"color:#172554;\">Talent<span style=\"color:#38a9df;\">Flow</span></strong>.\n      </p>\n\n      <!-- Separador -->\n      <div style=\"height:1px; background-color:#e5e7eb; margin:35px 0 20px 0;\"></div>\n\n      <!-- Footer -->\n      <div style=\"text-align:center;\">\n\n        <div style=\"font-size:18px; font-weight:bold; color:#172554;\">\n          Talent<span style=\"color:#38a9df;\">Flow</span>\n        </div>\n\n        <p style=\"font-size:12px; color:#9ca3af; line-height:1.5; margin:8px 0 0 0;\">\n          Plataforma de gestión y selección de talento\n        </p>\n\n        <p style=\"font-size:11px; color:#b0b7c3; margin:15px 0 0 0;\">\n          Este correo fue generado automáticamente.\n          Por favor, no respondas directamente a este mensaje.\n        </p>\n\n      </div>\n\n    </div>\n\n  </div>\n\n</div>",
        "options": {}
