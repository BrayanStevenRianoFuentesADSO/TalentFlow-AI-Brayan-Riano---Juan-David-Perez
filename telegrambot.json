    {
      "parameters": {
        "jsCode": "const datos= $(\"Telegram Trigger\").first().json.message.text\n\nconst id= datos.match(/TF-\\d+-\\d+/)\n\nif (!id){\n  throw new Error(\"no se encontro candidato con esa ID en el mensaje de telegram\")\n}\n\nconst idbuscado= id[0].trim()\n\nconst candidato = $input.all().find(item => {\n  const idHoja = String(item.json.ID_candidato ?? '').trim();\n  return idHoja === idbuscado;\n});\n\nif (!candidato) {\n  throw new Error(`No se encontró el candidato ${idbuscado} en Google Sheets`);\n}\n\nreturn [candidato];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        -80
      ],
      "id": "ed2d0544-4249-4e8c-9f9f-54d65791d255",
      "name": "agarra unicamente el candidato del mensaje"
    },
    {
      "parameters": {
        "jsCode": "const respuesta = $json.output;\n\nif (!respuesta) {\n  throw new Error(\"El AI Agent no devolvió una respuesta\");\n}\n\nlet tipoAccion;\n\nif (respuesta.includes(\"[ACCION: CONSULTA]\")) {\n  tipoAccion = \"CONSULTA\";\n} else if (respuesta.includes(\"[ACCION: CAMBIO_ESTADO]\")) {\n  tipoAccion = \"CAMBIO_ESTADO\";\n} else {\n  throw new Error(\"El AI Agent no indicó un tipo de acción válido\");\n}\n\nconst respuestaLimpia = respuesta\n  .replace(\"[ACCION: CONSULTA]\", \"\")\n  .replace(\"[ACCION: CAMBIO_ESTADO]\", \"\")\n  .trim();\n\nreturn [\n  {\n    json: {\n      tipo_accion: tipoAccion,\n      respuesta: respuestaLimpia\n    }\n  }\n];"
      },
